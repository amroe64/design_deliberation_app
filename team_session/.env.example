# Copy to .env (kept out of git) and fill in. Shell variables override these.
# The ARC API only answers from the VT network or the VT VPN.

MEDIATOR=llm
ARC_API_BASE=https://llm-api.arc.vt.edu/api/v1
ARC_API_KEY=
# Same model as the simulation (design_deliberation_A-v2.1). Reasoning is set by the model id.
MEDIATOR_MODEL=gpt-oss-120b-thinking-low

# Leave these unset to use the per-model values in server/mediator.py (MODELS).
# MEDIATOR_MAX_TOKENS=2400
# MEDIATOR_REQUEST_TIMEOUT=180
# MEDIATOR_TEMPERATURE=0.7
# MEDIATOR_REASONING=       # only to override the model id's reasoning level on purpose

# Seconds for a whole Mediator turn (retries included) before the stand-in answers.
AI_TIMEOUT=180
# Turns running at once. ARC allows 10 per key; keep headroom and use this key for nothing else.
AI_CONCURRENCY=8

# ADMIN_PIN=1234
