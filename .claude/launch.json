{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "team_session",
      "runtimeExecutable": "team_session/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "server.app:app",
        "--app-dir",
        "team_session",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "prototype",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8001",
        "--bind",
        "127.0.0.1",
        "--directory",
        "prototype"
      ],
      "port": 8001
    }
  ]
}